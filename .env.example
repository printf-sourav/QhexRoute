# Optional local quantum execution. The default demo stays deterministic and
# reports a classical fallback when the optional Qiskit stack is unavailable.
QHEXROUTE_ENABLE_QAOA=0
# Optional lower cap; values above the safe 12-variable ceiling are clamped.
QHEXROUTE_QAOA_VARIABLE_CAP=12
# Server-side wall-clock limit for the optional local QAOA worker.
QHEXROUTE_QAOA_TIMEOUT_SECONDS=15

# Use the checked-in OSMnx driving graph. Set to 0 only for the synthetic fallback.
QHEXROUTE_USE_OSM_GRAPH=1

# Optional frontend override in frontend/.env when the API is not proxied by Vite.
VITE_API_BASE=

# Interactive OpenStreetMap raster basemap used by the MapLibre demo.
# Keep the visible OSM attribution and follow the tile provider's usage policy.
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
